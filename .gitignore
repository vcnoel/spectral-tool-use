# Python
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# IDEs
.vscode/
.idea/

# Logs
logs/
*.log

# Model weights / checkpoints (large, regenerated by pipeline)
*.pt
*.pkl
*.bin
*.ckpt

# Data — large outputs regenerated by pipeline
data/
gsp_results/

# Dev scratch artifacts (spectral_feature_mining.py is tracked, rest are local only)
scratch/*.py
!scratch/spectral_feature_mining.py
scratch/*.jsonl
scratch/*.json
scratch/pilot_logs/
scratch/qwen_logs/

# Old dev/analysis scripts (kept locally, not part of paper artifact)
scripts/
experiments/
run_overnight.py
run_eval_only.py

# Tool internals
.claude/
wandb/

# Budget plan (Oct 2026): outputs written while the extraction queue runs. They are
# ignored so that the tree stays clean for the extractor's clean-tree guard, and are
# force-added (git add -f) when the results are frozen.
results/budget_oct2026/
results/swap_oct2026/bfcl_*
results/swap_oct2026/glaive_*
results/v2_oct2026/reader_types/*
